# ================================
# COMMON
# ================================
NODE_ENV=development

# ================================
# API (apps/api)
# ================================
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Database
MONGODB_URI=mongodb://localhost:27017/kobi_website

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Admin credentials (seed)
ADMIN_EMAIL=admin@kobi.com
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=Author Name

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# Preview
PREVIEW_TOKEN_SECRET=change-me-preview-secret
PREVIEW_TOKEN_EXPIRES_IN=24h

# ================================
# WEB (apps/web)
# ================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=কবির নাম

# ================================
# ADMIN (apps/admin)
# ================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000