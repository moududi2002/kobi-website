{
  "name": "@kobi/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm exec tsc",
    "start": "node -r tsconfig-paths/register dist/main.js",
    "start:dev": "concurrently -k \"pnpm exec tsc --watch\" \"node -r tsconfig-paths/register dist/main.js\"",
    "start:debug": "pnpm exec tsc --watch",
    "seed": "pnpm exec tsc && node -r tsconfig-paths/register dist/scripts/seed.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.7.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.6",
    "joi": "^17.13.0",
    "mongoose": "^8.6.0",
    "multer": "^2.4.0",
    "nanoid": "^3.3.19",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jest": "29",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/passport-jwt": "^4.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "jest": "29",
    "prettier": "^3.9.7",
    "source-map-support": "^0.5.21",
    "ts-jest": "29",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}